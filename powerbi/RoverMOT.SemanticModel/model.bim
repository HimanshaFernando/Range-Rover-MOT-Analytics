              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Affected per 1,000",
            "expression": "IF(HASONEVALUE('Category'[Name]),1000*DIVIDE(SUM(Defects[affected]),[Initial tests]))",
            "formatString": "0.0",
            "lineageTag": "99a5e4ee-58d8-58cd-89ac-0b156f03d18c"
          },
          {
            "name": "Scenario inspections",
            "expression": "SELECTEDVALUE(Volume[Inspections],200)",
