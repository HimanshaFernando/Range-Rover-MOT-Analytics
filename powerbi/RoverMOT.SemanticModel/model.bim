              "expression": [
                "let",
                "    Bytes = Binary.Decompress(Binary.FromText(Text.Combine({\"\"}),BinaryEncoding.Base64),Compression.Deflate),",
                "    Raw = Table.PromoteHeaders(Csv.Document(Bytes,[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv])),",
