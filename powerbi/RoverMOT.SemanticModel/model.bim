            "name": "Comparison",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Bytes = Binary.Decompress(Binary.FromText(Text.Combine({\"\"}),BinaryEncoding.Base64),Compression.Deflate),",
                "    Raw = Table.PromoteHeaders(Csv.Document(Bytes,[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv])),",
                "    Typed = Table.TransformColumnTypes(Raw,{{\"period\", type text}, {\"family\", type text}, {\"tests\", Int64.Type}, {\"observed_rate\", type number}, {\"adjusted_rate\", type number}, {\"support_share\", type number}, {\"common_strata\", Int64.Type}},\"en-GB\")",
                "in Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Observed rate",
            "expression": "VAR p = SELECTEDVALUE(Comparison[period],\"Combined\") RETURN IF(HASONEVALUE(Comparison[family]), CALCULATE(MAX(Comparison[observed_rate]), Comparison[period]=p))",
            "formatString": "0.0%",
            "lineageTag": "e84921ad-bcbc-5c73-a1af-9dc604c724c8"
          },
          {
            "name": "Standardised rate",
            "expression": "VAR p = SELECTEDVALUE(Comparison[period],\"Combined\") RETURN IF(HASONEVALUE(Comparison[family]), CALCULATE(MAX(Comparison[adjusted_rate]), Comparison[period]=p))",
            "formatString": "0.0%",
            "lineageTag": "c322dd61-add0-52be-ba7f-d2a685594932"
          },
          {
            "name": "Share on common support",
            "expression": "VAR p = SELECTEDVALUE(Comparison[period],\"Combined\") RETURN IF(HASONEVALUE(Comparison[family]), CALCULATE(MAX(Comparison[support_share]), Comparison[period]=p))",
            "formatString": "0.0%",
            "lineageTag": "34764bc9-9db0-5ea9-9b34-163a398e5811"
          },
          {
            "name": "Eligible common strata",
            "expression": "VAR p = SELECTEDVALUE(Comparison[period],\"Combined\") RETURN IF(HASONEVALUE(Comparison[family]), CALCULATE(MAX(Comparison[common_strata]), Comparison[period]=p))",
            "formatString": "0",
            "lineageTag": "c193e49c-cc5a-5401-a87a-60f1296a72d0"
          },
          {
            "name": "Selected comparison rate",
            "expression": "IF(SELECTEDVALUE(Basis[Method],\"Observed\")=\"Observed\",[Observed rate],[Standardised rate])",
            "formatString": "0.0%",
            "lineageTag": "feb2642a-f443-5374-a337-8c812bcea364"
          }
        ]
