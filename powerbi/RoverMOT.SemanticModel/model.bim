          },
          {
            "name": "Initial failure rate",
            "expression": "DIVIDE([Initially failed],[Initial tests])",
            "formatString": "0.0%",
            "lineageTag": "67ccb9e5-e45c-53f1-9367-f49fedc92094"
          },
          {
