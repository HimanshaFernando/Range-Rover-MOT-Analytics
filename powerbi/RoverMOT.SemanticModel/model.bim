            "lineageTag": "00130cc3-6be3-5dd9-8cd6-be3a3f3fbb22"
          },
          {
            "name": "Expected affected inspections",
            "expression": "DIVIDE([Affected per 1,000],1000)*[Scenario inspections]",
            "formatString": "0.0",
            "lineageTag": "719d9a53-74aa-5bd0-b14b-49a29d28284d"
